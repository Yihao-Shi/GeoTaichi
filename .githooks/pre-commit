#!/usr/bin/env bash
set -euo pipefail

PYTHON_EXECUTABLE="${GEOTAICHI_PYTHON:-$(git config --get geotaichi.python || command -v python)}"

files=()
while IFS= read -r -d '' file; do
    [[ "$file" == third_party/* ]] && continue
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py')

((${#files[@]})) || exit 0

for file in "${files[@]}"; do
    if ! git diff --quiet -- "$file"; then
        echo "pre-commit: $file has unstaged changes; stage or stash them first" >&2
        exit 1
    fi
done

"$PYTHON_EXECUTABLE" -m black --quiet -- "${files[@]}"
git add -- "${files[@]}"

"$PYTHON_EXECUTABLE" - "${files[@]}" <<'PY'
import subprocess
import sys

for path in sys.argv[1:]:
    compile(subprocess.check_output(["git", "show", ":" + path]), path, "exec")
PY
